rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if false; // No bulk scraping of user profiles
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role in ['vendor', 'ngo', 'collector', 'planner'];
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Surplus Food Listings
    match /food_listings/{listingId} {
      allow read: if true; // Public read for community relief NGOs & citizens
      allow create: if isSignedIn()
        && isValidId(listingId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.itemName is string
        && request.resource.data.portions is number
        && request.resource.data.status in ['available', 'claimed', 'collected', 'expired_locked', 'bridged_compost'];
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Drain Clearing Proof Reports
    match /drain_reports/{reportId} {
      allow read: if true; // Public transparency for municipal & citizen review
      allow create: if isSignedIn()
        && isValidId(reportId)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.hotspotId is string
        && request.resource.data.status in ['open', 'in_review', 'cleared'];
      allow update: if isSignedIn();
      allow delete: if false;
    }
  }
}
